# ---- Database (same cluster as the exhibition app) ----
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
LEADS_DB=zoho_exhibitions_rep_data
CONNECTOR_DB=zoho_connector

# ---- Zoho ----
# Must be the SAME login client the reps' refresh tokens were issued to,
# otherwise every refresh is rejected as an unknown client.
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
ZOHO_REGION=com
# Used only when Zoho rejects a rep's own address as the sender.
ZOHO_SENDER_EMAIL=
# Visible CC on every email the AI sends. Internal addresses are correct here:
# being copied on a rep's outgoing mail is not the same as being written to as
# a lead, so EXCLUDED_EMAIL_DOMAINS does not apply. Seeds the setting on first
# run only; after that the dashboard owns it.
CC_EMAILS=

# ---- ERP (quotes) ----
# Without these the Quotes tab says it is not configured rather than failing.
ERP_BASE_URL=https://erp.print247.us
ERP_API_TOKEN=
# The pouch price calculator refuses the bearer above and wants a token minted
# from this one instead. Without it the chat gives no instant prices.
ERP_REFRESH_TOKEN=b364d3bdd3297de0d30ea45f6ced2ba9288cf0f6c78df4ba0260d3dd0de9192f
# Instant prices in chat for flat and stand up pouches. false turns them off.
ERP_INSTANT_PRICING=true

# Vercel Blob store for files visitors share in a chat (SalesIQ links expire after the chat).
# Vercel → Storage → Blob → the store → .env.local tab. Empty = files are not kept.
BLOB_READ_WRITE_TOKEN=

# Main backend (print247-node), for ecommerce lead figures by PPC / organic / social
# beside the chat funnel. Any backend dashboard account; it only reads.
BACKEND_URL=https://print247-node.vercel.app
BACKEND_EMAIL=
BACKEND_PASSWORD=

# ---- AI Providers & Multi-Tier Fallback ----
# The service uses a 3-tier automatic fallback:


# 3. OpenAI / ChatGPT (Fallback 2)
OPENAI_API_KEY=xx
enai.com/v1
OOPENAI_MODEL=gpt-4o-mini


# ---- Worker timing ----
WORKER_POLL_SECONDS=60
FIRST_CONTACT_DELAY_MINUTES=15
CHASE_AFTER_HOURS=48

# ---- Eligibility ----
# Internal domains that must never receive an AI conversation.
EXCLUDED_EMAIL_DOMAINS=print247.us,colorwing.com
# Lead sources that are not enquiries: a newsletter signup subscribed to a
# mailing list, a website visit is a page view Zoho logged by itself. Neither
# asked to be contacted. Matched as substrings of the CRM source, so one entry
# covers every brand's variant. "Website Quote" is an enquiry and is unaffected.
EXCLUDED_LEAD_SOURCES=newsletter,website visit
# Blast radius while the system is new: one rep's leads only. Empty = everyone.
ONLY_REP_EMAIL=
# Work through leads captured before the service started.
INCLUDE_EXISTING_LEADS=false
MAX_LEAD_AGE_DAYS=14

# ---- Guardrails ----
MAX_AI_MESSAGES=5
MAX_CONVERSATION_DAYS=21
STOP_WHEN_REP_REPLIES=true
STOP_ON_OPT_OUT=true
# Composes and stores emails without sending. Leave true until you have read
# what it writes.
DRY_RUN=true

# ---- SalesIQ chat bot ----
# Shared secret the Zobot presents on every call to /webhooks/salesiq. The
# webhook has no session cookie, so this is the only thing protecting it.
# Empty means the endpoint rejects everything.
SALESIQ_WEBHOOK_TOKEN=
# What the bot says while the contract is still being measured.
SALESIQ_CAPTURE_REPLY=Thanks for getting in touch! One of our team will be with you shortly.
# SalesIQ signs every event with RSA rather than sending a token. Copy the
# public key from the Zobot's "Secure your webhook" panel — the bare base64 the
# portal shows is fine, the PEM header and footer are added for you.
SALESIQ_PUBLIC_KEY=
# Accept a request whose signature did not verify, so the signature header can
# be identified. On for the capture phase only. Turn OFF before the bot starts
# composing real replies, or anyone can spend the OpenAI budget.
SALESIQ_CAPTURE_UNVERIFIED=false
# Seed values for the chat bot; the dashboard owns them after first run.
SALESIQ_ENABLED=false
SALESIQ_DRY_RUN=true
SALESIQ_MAX_AI_MESSAGES=50
# ---- WhatsApp bridge (chat alerts to the team group) ----
# The group itself is a dashboard setting; these two are credentials.
WHATSAPP_BASE_URL=https://biztek-whatsapp-testing-production.up.railway.app
WHATSAPP_SESSION_ID=
WHATSAPP_API_KEY=
