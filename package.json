{
  "name": "lead-follow-up",
  "version": "0.1.0",
  "private": true,
  "description": "AI email conversation that qualifies an exhibition lead until it has enough information to quote.",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run check:dashboard && tsc && npm run copy-assets",
    "copy-assets": "node -e \"require('fs').cpSync('src/server/public','dist/server/public',{recursive:true})\"",
    "start": "node dist/main.js",
    "dev": "nodemon src/main.ts",
    "dev:worker": "nodemon src/worker.ts",
    "create-admin": "ts-node --transpile-only src/scripts/createAdmin.ts",
    "check": "ts-node --transpile-only src/scripts/whoWouldGetMail.ts",
    "smoke": "ts-node --transpile-only src/scripts/smoke.ts",
    "test:hours": "ts-node --transpile-only src/scripts/testOfficeHours.ts",
    "typecheck": "tsc --noEmit",
    "probe:zoho": "ts-node --transpile-only src/scripts/probeZoho.ts",
    "test:send": "ts-node --transpile-only src/scripts/testSendWindow.ts",
    "dev:dashboard": "nodemon src/index.ts",
    "check:dashboard": "ts-node --transpile-only src/scripts/checkDashboard.ts",
    "funnel": "ts-node --transpile-only src/scripts/checkChatFunnel.ts",
    "backfill:attachments": "ts-node --transpile-only src/scripts/backfillChatAttachments.ts",
    "backfill:sources": "ts-node --transpile-only src/scripts/backfillTrafficSource.ts",
    "set:cc": "ts-node --transpile-only src/scripts/setCcEmails.ts",
    "test:cc": "ts-node --transpile-only src/scripts/testCcSend.ts",
    "test:asks": "ts-node --transpile-only src/scripts/testAskCounts.ts",
    "chats": "ts-node --transpile-only src/scripts/inspectChats.ts",
    "apply:script": "ts-node --transpile-only src/scripts/applySalesScript.ts",
    "test:sizes": "ts-node --transpile-only src/scripts/testSizeUnits.ts",
    "test:finishes": "ts-node --transpile-only src/scripts/testFinishes.ts",
    "test:minimum": "ts-node --transpile-only src/scripts/testMinimumOrder.ts",
    "test:not-a-customer": "ts-node --transpile-only src/scripts/testNotACustomer.ts",
    "test:live-agents": "ts-node --transpile-only src/scripts/testLiveAgents.ts",
    "test:rotation": "ts-node --transpile-only src/scripts/testLeadRotation.ts",
    "test:language": "ts-node --transpile-only src/scripts/testVisitorLanguage.ts",
    "test:plain": "ts-node --transpile-only src/scripts/testPlainPackaging.ts",
    "test:chat-edges": "ts-node --transpile-only src/scripts/testChatEdges.ts",
    "test:timing": "ts-node --transpile-only src/scripts/testChatTiming.ts",
    "drain:chat-leads": "ts-node --transpile-only src/scripts/drainChatLeadBacklog.ts",
    "refile:chat-leads": "ts-node --transpile-only src/scripts/refileChatLeads.ts",
    "rebalance:chat-leads": "ts-node --transpile-only src/scripts/rebalanceChatLeads.ts",
    "test:contacts": "ts-node --transpile-only src/scripts/testOurOwnContacts.ts",
    "test:existing": "ts-node --transpile-only src/scripts/testExistingCustomer.ts",
    "test:chat-view": "ts-node --transpile-only src/scripts/testChatWebView.ts",
    "test:price": "ts-node --transpile-only src/scripts/testInstantPrice.ts",
    "test:price-scenarios": "ts-node --transpile-only src/scripts/testPricingScenarios.ts",
    "test:e2e": "ts-node --transpile-only src/scripts/e2eChats.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^1.5.2",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mongoose": "^8.9.0",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
